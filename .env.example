# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
# All three are NEXT_PUBLIC_ (read in the browser); none is a secret.

# Google OAuth web client ID for Drive sync (the long ...apps.googleusercontent.com
# string). Required on every instance that signs in to Drive — your PC, the Vercel
# deployment, and any other local device. The OAuth client's authorized JS origins
# must include each instance's URL. See docs/Architecture.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Set to 1 on the PC ONLY. Marks this instance as the one that persists data/*.json
# and reconciles the projects/ folders during a Drive sync. Leave unset elsewhere.
NEXT_PUBLIC_UNTIL_PC=

# Set to 1 ONLY on a throwaway public-demo deployment to serve the data-example/
# seed. Leave UNSET on your real app so it starts empty and is a pure Drive client.
# Never sign in / sync on a demo instance — it would push demo data into your Drive.
NEXT_PUBLIC_UNTIL_DEMO=
